# Copy to .env.local. Real values never go in this file.

# Supabase project URL and publishable key. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Supabase dashboard > Project Settings > API Keys > Secret keys.
SUPABASE_SECRET_KEY=

# Server only, optional. Raises GitHub's limit from 60 to 5,000 requests an hour.
# Use a fine-grained token with no repository access; public data needs none.
GITHUB_TOKEN=
